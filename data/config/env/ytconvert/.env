APP_NAME=YTConvert
APP_ENV=production
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8010
APP_TIMEZONE=Asia/Seoul
APP_PUBLIC_URL=https://your-domain.kr
APP_ALLOWED_HOSTS=your-domain.kr,127.0.0.1,localhost
FFMPEG_PATH=/bin/ffmpeg
MEDIA_MAX_CONCURRENT_JOBS=1
MEDIA_OUTPUT_RETENTION_HOURS=24
MEDIA_WORKER_ENABLED=true
INTERNAL_IP_RANGES=111.222.333.444/32,127.0.0.0/8,192.165.0.0/24,::1/128
