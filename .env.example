APP_NAME=YTConvert
APP_ENV=development
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8010
APP_TIMEZONE=Asia/Seoul
# Host-specific example; each operator must set their own URL and allowed hosts.
APP_PUBLIC_URL=https://ytconvert.glitter.kr
APP_ALLOWED_HOSTS=ytconvert.glitter.kr,127.0.0.1,localhost
APP_IP_BLOCKLIST_FILE=data/config/blocked_ips.json
# Empty by default: all conversion-job creation is denied. Configure only approved client networks.
INTERNAL_IP_RANGES=
APP_ENABLE_OPENAPI=false
FFMPEG_PATH=/opt/bin/ffmpeg
MEDIA_MAX_CONCURRENT_JOBS=1
MEDIA_OUTPUT_RETENTION_HOURS=24
FFPROBE_PATH=/opt/bin/ffprobe
# Keep disabled until the operator reviews legal permissions and deployment security.
MEDIA_WORKER_ENABLED=false
MEDIA_MAX_QUEUED_JOBS=10
MEDIA_MAX_DURATION_SECONDS=3600
MEDIA_MAX_DOWNLOAD_BYTES=1073741824
MEDIA_MAX_OUTPUT_BYTES=1073741824
MEDIA_JOB_TIMEOUT_SECONDS=1800
MEDIA_SESSION_TTL_HOURS=168
